# application vars
NEXT_PUBLIC_VERSION=$npm_package_version
NEXT_PUBLIC_NAME="e-shop"

# api vars
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_HOST=127.0.0.1
NEXT_PUBLIC_API_PORT=8088
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_PROTOCOL}://${NEXT_PUBLIC_API_HOST}:${NEXT_PUBLIC_API_PORT}

# next-auth
NEXTAUTH_SECRET=

# google vars
NEXT_PUBLIC_GOOGLE_RECAPTCHA_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# facebook vars
NEXT_PUBLIC_FACEBOOK_APP_ID=
